#!  /bin/bash

##        25b_add_email_check.bsh    2026-08-11
#
#


sed --in-place --file=-   ./comptonTransAnlys_25_add_email_check.sql    <<EOF  ;

#                                             added 2026-08-10
/PRIMARY KEY (\`teacherAutoIncr\`),/a                                                        \\
CONSTRAINT \`validateTeacherEmail\` CHECK (\`teacherEmail\`     LIKE '%@%._%' ),             \\

/PRIMARY KEY (\`clientMasterAutoIncr\`),/a                                                   \\
CONSTRAINT \`validateClientEmail\` CHECK (\`clientMasterEmail\`     LIKE '%@%._%' ),         \\

EOF
exit;












mariadb  --verbose  comptonTransAnlys  <<END ;

   
    ALTER TABLE \`teacher\`         ADD CONSTRAINT \`validateTeacherEmail\` CHECK (\`teacherEmail\`      LIKE '%@%._%' )     ;

    
    ALTER TABLE \`clientMaster\`    ADD CONSTRAINT \`validateClientEmail\`  CHECK (\`clientMasterEmail\` LIKE '%@%._%' )     ; 

END
