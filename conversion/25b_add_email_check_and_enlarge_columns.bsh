#!  /bin/bash

##        25b_add_email_check_and_enlarge_columns.bsh    2026-08-11
#
#


sed --in-place --file=-   .   /comptonTransAnlys_25_add_email_check_and_enlarge_columns.sql    <<EOF  ;


EOF
exit;












mariadb  --verbose  comptonTransAnlys  <<END ;

    ALTER TABLE \`teacher\`         MODIFY \`teacherEmail\`        VARCHAR(256)                                              ;
    ALTER TABLE \`teacher\`         ADD CONSTRAINT \`validateTeacherEmail\` CHECK (\`teacherEmail\`      LIKE '%@%._%' )     ;

    ALTER TABLE \`clientMaster\`    MODIFY \`clientMasterEmail\`    VARCHAR(256)                                             ;
    ALTER TABLE \`clientMaster\`    ADD CONSTRAINT \`validateClientEmail\`  CHECK (\`clientMasterEmail\` LIKE '%@%._%' )     ; 

END
