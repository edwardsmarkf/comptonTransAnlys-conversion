gzip   ./comptonTransAnlys_25_add_email_check.sql                    ;
gzip   ./comptonTransAnlys_25_add_email_check-COPY-BEFORE-EMAIL.sql  ;


/usr/bin/mariadb    --verbose  comptonTransAnlys  <<END ;

    SELECT COUNT(*) FROM  \`teacher\`      ;
    SHOW CREATE TABLE     \`teacher\`      ;

    SELECT COUNT(*) FROM  \`clientMaster\` ;
    SHOW CREATE TABLE     \`clientMaster\` ;

END

exit;
