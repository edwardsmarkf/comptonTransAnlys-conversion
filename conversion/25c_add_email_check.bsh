diff  ./comptonTransAnlys_25_add_email_check.sql   ./comptonTransAnlys_25_add_email_check-COPY-BEFORE-EMAIL.sql  ;
#
mariadb comptonTransAnlys   <   ./comptonTransAnlys_25_add_email_check.sql ;
