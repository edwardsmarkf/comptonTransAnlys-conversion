#! /bin/bash

 npx feathers generate service   --name    knex-generic-raw --path  knex-generic-raw  --type custom   ;

 ? Does this service require authentication? No
? Which schema definition format do you want to use?  No schema




// This is a skeleton for a custom service class. Remove or add the methods you need here

import { returnSqlStatement }  from './knex-generic-raw.custom.js';             // new - added entire line

export class KnexGenericRawService {
  constructor(options) {
    this.options = options
    this.app = options.app;                             // new line
  }

  async find(_params) {

                /*      postman testing:
                                http://192.168.100.144:3030/knex-generic-raw/?knexSQL=selectVersion
                                http://192.168.100.144:3030/knex-generic-raw/?knexSQL=soundSelectorSelectSQL&LAYOUT_NAME=PESL
                */
        const knexClient = this.app.get('mysqlClient');         // old way: const knexClient = this.app.get('knexClient');
        const sqlStatement = returnSqlStatement(_params.query.knexSQL)  ;
        const [result] =  await knexClient.raw( sqlStatement );
        return result;








// This is a skeleton for a custom service class. Remove or add the methods you need here

export class KnexGenericRawService {
  constructor(options = {} ) {                          // added:  "= {} "
    this.options = options
    this.app = options.app;                             // new line
  }

  async find(_params) {
    const knexClient = this.app.get('mysqlClient');     
    const [rows] =  await knexClient.raw( 'SELECT VERSION() ;'  ,   _params.query);
    return rows;
  }
