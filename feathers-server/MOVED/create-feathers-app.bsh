#! /bin/bash

##   create-feathers-app.bsh   -- 2026-07-13

##   create the feathers app using tcl/expect


export ScriptName="${BASH_SOURCE[0]##*/}"                                               ;
export TimeStamp=$(date +'%Y-%m-%d_%H-%M-%S';)                                          ;
export appName='my-feathers-app'                                                        ;

expect <(cat <<'END_OF_GENERATE_APP'
        #       generates an application, taking ALL the defaults

        set timeout -1                                                                  ;

        set UPARROW     \x1B\[A                                                         ;
        set DOWNARROW   \x1B\[B                                                         ;
        set SPACE       \x20                                                            ;
        set RETURN      \x0d                                                            ;

        spawn npm   --yes  create feathers@latest $env(appName)                         ;

        expect -re ".*Do you want to use JavaScript or TypeScript.*"                    ;
        send -- "${DOWNARROW}${RETURN}"                                                 ;
                        ## selects javascript

        expect -re ".*Write a short description.*"                                      ;
        send -- "$env(TimeStamp) -- Auto-creating app using $env(ScriptName)${RETURN}"  ;

        expect -re ".*Which HTTP framework do you want to use.*"                        ;
        send -- "${RETURN}"                                                             ;

        expect -re ".*What APIs do you want to offer.*"                                 ;
        send -- "${RETURN}"                                                             ;

        expect -re ".*Which package manager are you using.*"                            ;
        send -- "${RETURN}"                                                             ;

        expect -re ".*Generate client.*"                                                ;
        send -- "n${RETURN}"                                                            ;

        expect -re ".*What is your preferred schema \\(model\\) definition format.*"    ;
        send -- "${RETURN}"                                                             ;
                        ##  TypeBox (recommended)

        expect -re ".*Which database are you connecting to.*"                           ;
        send -- "${DOWNARROW}${DOWNARROW}${DOWNARROW}${RETURN}"                         ;
                        ##  MySQL/MariaDB

        expect -re ".*Enter your database connection string.*"                          ;
        send -- "mysql://mark:mark@localhost:3306/comptonTransAnlys${RETURN}"           ;
                        ## defaults to 'mysql://root@localhost:3306/my-app'
                        ## which will be edited later

expect eof

END_OF_GENERATE_APP
)       ## end of feathers generate app

npx feathers generate service   --name client-context --path client-context --type knex  ;
sed  --expression="s/name: 'client-context'/name: 'clientContext', id: 'clientContextAutoIncr'/;"    my-test-service.class.js ;


npx feathers generate hook  -- ??

             hook content example:

module.exports = (options = {}) => {
  return async context => {

        const knexClient =   context.app.get('knexClient') ;

        const query = context.service.createQuery(context.params) ;

        // https://knexjs.org/guide/query-builder.html#knex
        query   .clear  ('select')  // remove ALL existing columns from queryBuilder
                .select (       { 'contextAutoIncr'             : 'contextAutoIncr'                             }
                        ,       knexClient.raw('CONCAT(`contextPosition` , "-" , `soundPhoneme`) AS positionSound')
                        ,       { 'frequency'                   : 'frequency'                                   }
                        ,       { 'clientContextErrorSound'     : 'clientContextErrorSound'                     }
                        ,       { 'clientContextErrorCount'     : 'clientContextErrorCount'                     }
                        ,       { 'clientContextErrorNotes'     : 'clientContextErrorNotes'                     }
                        ,       { 'clientContextAutoIncr'       : 'clientContextAutoIncr'                       }
                        )
                .orderBy('contextAutoIncr')
                ;

        context.params.knex = query ;

    return context;
  };
};




exit ;


