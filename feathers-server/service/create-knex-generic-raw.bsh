#! /bin/bash


##   create-knex-generic-raw.bsh   -- 2026-07-22

##   create the feathers service using tcl/expect


export serviceName='knex-generic-raw'                                                                                    ;
export serviceType='custom'                                                                                              ;

expect <(cat <<'END_OF_GENERATE_APP'
        #       generates a feathers service

        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate service   --name  $env(serviceName)   --path $env(serviceName)   --type $env(serviceType)   ;

        expect -re ".*Does this service require authentication.*"                                                       ;
        send -- "n${RETURN}"                                                                                            ;

        expect -re ".*Which schema definition format do you want to use.*"                                              ;
        send -- "${RETURN}"                                                                                             ;

expect eof

END_OF_GENERATE_APP
)       ## end of feathers generate app


sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.class.js   <<END_OF_SED ;

2i                                                                                                                      \\
                                                                                                                        \\
 import { readFile } from 'fs/promises';        /* added by mark */                                                     \\
                                                                                                                        \\
#

/^  async find(_params) {$/a                                                                                            \\
                                                                                                                        \\
            /*      postman testing:                                                                                    \\
                        http://192.168.100.144:3030/knex-generic-raw/?knexSQL=serverVersionNow?                         \\
                        http://192.168.100.144:3030/knex-generic-raw/?knexSQL=soundSelectorSelectSQL&LAYOUT_NAME=PESL   \\
            */                                                                                                          \\
      const knexClient = this.options.app.get('mysqlClient');                                                           \\
      const sqlFile    = process.cwd() + '/src/services/knex-generic-raw/sql/' + _params.query.knexSQL   + '.sql'  ;    \\
      const sqlStatement = await readFile(sqlFile, 'utf8');                                                             \\
      const [sqlResult] =  await knexClient.raw( sqlStatement.replaceAll("\\\\n",' '), _params.query );                 \\
                                                                                                                        \\
      let result;                                                                                                       \\
      if  ( typeof sqlResult[0].JSON_ARRAYAGG       == 'string' )        {                                              \\
              result = sqlResult[0].JSON_ARRAYAGG   ;                                                                   \\
      } else if ( typeof sqlResult[0] == 'object' )        {                                                            \\
              result = sqlResult[0];                                                                                    \\
      } else {                                                                                                          \\
              result = sqlResult;                                                                                       \\
      }                                                                                                                 \\


s/return \[]/return result;/;

END_OF_SED


exit;

#
