#! /bin/bash


##   date-time.bsh   -- 2026-08-15


export globalComment=${1}                                                                                                ;
export serviceName='date-time'                                                                                           ;

sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.class.js   <<END_OF_SERVICE_CLASS_SED          ;

/^  async find(_params) {$/a                                                                                             \\
                                                                                                                         \\
    const datetime = new Date().toString();                                                                              \\
    console.log(datetime);                                                                                               \\

s/return \[]/ return [{datetime:datetime}];/          ;

END_OF_SERVICE_CLASS_SED

echo "Testing:  ${FEATHERS_URL}${serviceName}/"       ;

exit;

