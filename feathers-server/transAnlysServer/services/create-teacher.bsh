#! /bin/bash

##   create-client-session.bsh   -- 2026-08-01

##   create the feathers service using tcl/expect


export serviceName='teacher'                                                                ;
export tableName='teacher'                                                                  ;
export serviceType='knex'                                                                   ;


bash -vx  ../services/template-create.bsh    ${serviceName}  ${tableName}   ${serviceType}  ;

exit                                                                                        ;







expect <(cat <<'END_OF_GENERATE_SERVICE'
        #       generates a feathers service

        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate service   --name  $env(serviceName)   --path $env(serviceName)   --type $env(serviceType)   ;

        expect -re ".*Does this service require authentication.*"                                                       ;
        send -- "n${RETURN}"                                                                                            ;

        expect -re ".*Which schema definition format do you want to use.*"                                              ;
        send -- "${RETURN}"                                                                                             ;

expect eof

END_OF_GENERATE_SERVICE
)       ## end of feathers generate app


sed  --in-place  --expression="s/name: '${serviceName}'/name: '${tableName}', id: '${tableName}AutoIncr'/;"             \
        ./src/services/${serviceName}/${serviceName}.class.js                                                           ;

exit;

#
