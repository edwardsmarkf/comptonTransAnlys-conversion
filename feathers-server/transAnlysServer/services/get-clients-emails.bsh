#! /bin/bash


##   get-clients-emails.bsh   -- 2026-07-22

export globalComment=${1}                                                                                         ;
export serviceName='get-clients-emails'                                                                           ;

sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.schema.js   <<END_OF_SCHEMA_SED         ;
s|^  { additionalProperties: false }|  { additionalProperties: true }     ${globalComment}                       |;
END_OF_SCHEMA_SED



sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.class.js   <<END_OF_SERVICE_CLASS_SED       ;

2i                                                                                                                    \\
                                                                                                                      \\
import { getClientsEmails } from  '../../custom/getClientsEmails.js' ;    ${globalComment}                            \\


/^  async find(_params) {$/a                                                                                                     \\
    // 1. Log structural diagnostics to your terminal console                                                                    \\
    console.log('--- DIAGNOSTIC START ---');                                                                                     \\
    console.log('this.options keys:', Object.keys(this.options || {}));                                                          \\
    console.log('_params keys:', Object.keys(_params || {}));                                                                    \\
    if (_params?.route) console.log('_params.route:', _params.route);                                                            \\
    if (_params?.connection) console.log('Has connection:', !!_params.connection);                                               \\
    console.log('--- DIAGNOSTIC END ---');                                                                                       \\
                                                                                                                                 \\
    // 2. Try an aggressive deep look to see if Feathers tucked app into an options container                                    \\
    const appInstance = this.options?.app || _params?.app;                                                                       \\
                                                                                                                                 \\
    // If it's still missing, let's look for alternative injection spots                                                         \\
    if (!appInstance || typeof appInstance.get !== 'function') {                                                                 \\
      throw new Error(`Feathers app context not found on expected injection objects. Inspect your console logs above.`);         \\
    }                                                                                                                            \\
                                                                                                                                 \\
    const getEmailsInstance = new getClientsEmails(appInstance);                                                                 \\
    const [emailResult] = await getEmailsInstance.getClientsEmails(_params);                                                     \\
                                                                                                                                 \\

s/return \[]/return emailResult/  ;
 
END_OF_SERVICE_CLASS_SED

echo "Testing:  ${FEATHERS_URL}${serviceName}/?LAYOUT_NAME=PESL&TEACHER_EMAIL=info@englishwithoutaccent.com" ;

exit;







2i                                                                                                                \\
                                                                                                                      \\
                           // import { getClientsEmail } from 'fs/promises';        /* added by mark */               \\
                                                                                                                      \\




















##   create the feathers service using tcl/expect


export serviceName='get-clients-emails'                                                                                    ;
export serviceType='custom'                                                                                              ;

expect <(cat <<'END_OF_GENERATE_SERVICE'
        #       generates a feathers service

        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate service   --name  $env(serviceName)   --path $env(serviceName)   --type $env(serviceType)   ;

        expect -re ".*Does this service require authentication.*"                                                       ;
        send -- "n${RETURN}"                                                                                            ;

        expect -re ".*Which schema definition format do you want to use.*"                                              ;
        send -- "${RETURN}"                                                                                             ;

expect eof

END_OF_GENERATE_SERVICE
)       ## end of feathers generate app
