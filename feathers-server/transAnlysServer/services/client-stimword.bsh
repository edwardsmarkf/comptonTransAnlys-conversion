#!  /bin/bash

#      client-stimword.bsh    2026-08-23


globalComment=${1}                 ;
                                                            ##serviceName=${1}     ;
serviceName=$(basename "${0%.*}")  ;

tableName=$(echo ${serviceName} | sed --regexp-extended 's/-([a-z])/\U\1/g' ;)                                                                             ; 

sed    --in-place  --expression="s|name: '${serviceName}'|name: '${tableName}', id: '${tableName}AutoIncr'  , multi: ['patch']   ${globalComment} |; "     \
                        ./src/services/${serviceName}/${serviceName}.class.js                                                                              ;


sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.schema.js   <<END_OF_SCHEMA_SED      ;

/    id: Type.Number(),/{N; s/    id: Type.Number(),\n    text: Type.String()/                                   \\
       layoutName                       : Type.String({ maxLength: 4 })                        ${globalComment}  \\
    ,  teacherEmail                     : Type.String({ maxLength: 255 })                      ${globalComment}  \\
    ,  clientMasterEmail                : Type.String({ maxLength: 255 })                      ${globalComment}  \\
    ,  sessionName                      : Type.String({ maxLength: 30 })                       ${globalComment}  \\
    ,  soundPhoneme                     : Type.String({ maxLength: 3 })                        ${globalComment}  \\
    ,  contextPosition                  : Type.String({ maxLength: 20 })                       ${globalComment}  \\
    ,  clientContextErrorSound          : Type.String({ maxLength: 4 })                        ${globalComment}  \\
    ,  stimwordPlacement                : Type.Number()                                        ${globalComment}  \\
    ,  stimwordOrderNbr                 : Type.Number()                                        ${globalComment}  \\
    ,  stimwordWord                     : Type.String({ maxLength: 25 })                       ${globalComment}  \\
    ,  stimwordPositionNbr              : Type.Number()                                        ${globalComment}  \\
    ,  stimwordPositionSetting          : Type.String({ maxLength: 20 })                       ${globalComment}  \\
    ,  clientStimwordNotes              : Type.Optional(Type.String())                         ${globalComment}  \\
    ,  createdAt                        : Type.String({ format: 'date-time' })                 ${globalComment}  \\
    ,  updatedAt                        : Type.String({ format: 'date-time' })                 ${globalComment}  \\
    ,  stimwordPositionAutoIncr         : Type.Number()                                        ${globalComment}  \\
    ,  clientContextAutoIncr            : Type.Number()                                        ${globalComment}  \\
    ,  clientStimwordAutoIncr           : Type.Optional(Type.Integer())                        ${globalComment}  \\
/}                                                                                                               ;
#
#
#
s/\['text']/                                          \\
  [  'layoutName'                   ${globalComment}  \\
  ,  'teacherEmail'                 ${globalComment}  \\
  ,  'clientMasterEmail'            ${globalComment}  \\
  ,  'sessionName'                  ${globalComment}  \\
  ,  'soundPhoneme'                 ${globalComment}  \\
  ,  'contextPosition'              ${globalComment}  \\
  ,  'clientContextErrorSound'      ${globalComment}  \\
  ,  'stimwordPlacement'            ${globalComment}  \\
  ,  'stimwordOrderNbr'             ${globalComment}  \\
  ,  `stimwordWord'                 ${globalComment}  \\
  ,  'stimwordPositionNbr'          ${globalComment}  \\
  ,  'stimwordPositionSetting'      ${globalComment}  \\
  ,  'clientStimwordNotes'          ${globalComment}  \\
  ,  'createdAt'                    ${globalComment}  \\
  ,  'updatedAt'                    ${globalComment}  \\
  ,  'stimwordPositionAutoIncr'     ${globalComment}  \\
  ,  'clientContextAutoIncr'        ${globalComment}  \\
  ,  'clientStimwordnAutoIncr'      ${globalComment}  \\
  ]                                                   \\
/                                                     ;
#
#
END_OF_SCHEMA_SED


echo "Testing:  ${FEATHERS_URL}${serviceName}/"                                              ;











exit;
