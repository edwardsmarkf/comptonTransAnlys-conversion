#! /bin/bash


##   knex-generic-raw.bsh   -- 2026-07-22


export globalComment=${1}                                                                                                ;
export serviceName='knex-generic-raw'                                                                                    ;


sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.schema.js   <<END_OF_SCHEMA_SED                   ;
s|^  { additionalProperties: false }|  { additionalProperties: true }  ${globalComment}                                     |;
END_OF_SCHEMA_SED


sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.class.js   <<END_OF_SERVICE_CLASS_SED             ;

2i                                                                                                                          \\
                                                                                                                            \\
 import { readFile } from 'fs/promises';        ${globalComment}                                                            \\
                                                                                                                            \\

/^  async find(_params) {$/a                                                                                                \\
                                                                                                                            \\
            /*      postman testing:                                                                                        \\
                        http://192.168.100.144:3030/knex-generic-raw/?knexSQL=serverVersionNow                              \\
                        http://192.168.100.144:3030/knex-generic-raw/?knexSQL=soundSelectorSelectSQL&LAYOUT_NAME=PESL       \\
            */                                                                                                              \\
      const knexClient   = this.options.app.get('mysqlClient');                                           ${globalComment}  \\
      const sqlFile      = process.cwd() + '/src/sql/' + _params.query.knexSQL   + '.sql'  ;              ${globalComment}  \\
      const sqlStatement = await readFile(sqlFile, 'utf8');                                               ${globalComment}  \\
      const [sqlResult]   =  await knexClient.raw( sqlStatement.replaceAll("\\\\n",' '), _params.query ); ${globalComment}  \\
                                                                                                          ${globalComment}  \\
      let result;                                                                                         ${globalComment}  \\
      if  ( typeof sqlResult[0].JSON_ARRAYAGG       == 'string' )        {                                ${globalComment}  \\
              result = sqlResult[0].JSON_ARRAYAGG   ;                                                     ${globalComment}  \\
      } else if ( typeof sqlResult[0] == 'object' )        {                                              ${globalComment}  \\
              result = sqlResult[0];                                                                      ${globalComment}  \\
      } else {                                                                                            ${globalComment}  \\
              result = sqlResult;                                                                         ${globalComment}  \\
      }                                                                                                   ${globalComment}  \\


s/return \[]/return result;/;

END_OF_SERVICE_CLASS_SED

echo "http://$(hostname --all-ip-addresses | sed --expression='s/ //;' )/${serviceName}:3030/?knexSQL=serverVersionNowSQL&param=parameter test" ;


exit;

#









##   create the feathers service using tcl/expect


export serviceName='knex-generic-raw'                                                                                    ;
export serviceType='custom'                                                                                              ;

expect <(cat <<'END_OF_GENERATE_SERVICE'
        #       generates a feathers service

        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate service   --name  $env(serviceName)   --path $env(serviceName)   --type $env(serviceType)   ;

        expect -re ".*Does this service require authentication.*"                                                       ;
        send -- "n${RETURN}"                                                                                            ;

        expect -re ".*Which schema definition format do you want to use.*"                                              ;
        send -- "${RETURN}"                                                                                             ;

expect eof

END_OF_GENERATE_SERVICE
)       ## end of feathers generate app
