#!  /bin/bash

#   generic template to do the single-table services      2026-08-01
#
#
export serviceName=${1}     ;
export serviceType=${2}     ;
export globalComment=${3}   ;
                                            ############export specialProcess=${4}  ;


export scriptName="${BASH_SOURCE[0]##*/}"                                           ;

echo  "Beginning ${scriptName}"                                                     ;
echo  ${serviceName}  ${serviceType}  ${globalComment}                              ;
echo  '-----------------------'                                                     ;

expect <(cat <<'END_OF_GENERATE_SERVICE'
        #       generates a feathers service

        set timeout -1                                                             ;

        set UPARROW     \x1B\[A                                                    ;
        set DOWNARROW   \x1B\[B                                                    ;
        set SPACE       \x20                                                       ;
        set RETURN      \x0d                                                       ;

        spawn npx feathers generate service   --name  $env(serviceName)            \
                                              --path  $env(serviceName)            \
                                              --type  $env(serviceType)            ;

        expect -re ".*Does this service require authentication.*"                   ;
        send -- "n${RETURN}"                                                        ;

        expect -re ".*Which schema definition format do you want to use.*"          ;
        send -- "${RETURN}"                                                         ;

expect eof

END_OF_GENERATE_SERVICE
)       ## end of feathers generate app



                                                        #####################################if [ -n "${specialProcess}" ]; then
if  [ -f ../services/${serviceName}.bsh ]; then
    echo "Special modification for service ${serviceName} using special process: ${serviceName}.bsh...!"                  ;
    bash -vx  ../services/${serviceName}.bsh      ${globalComment}                                                        ;
fi

if  [ "${serviceType}" == 'knex' ]; then

    export tableName=$(echo ${serviceName} | sed --regexp-extended 's/-([a-z])/\U\1/g' ;)                                                  ; 

    sed    --in-place  --expression="s|name: '${serviceName}'|name: '${tableName}', id: '${tableName}AutoIncr'   ${globalComment} |; "     \
                        ./src/services/${serviceName}/${serviceName}.class.js                                                              ;
    echo "Testing:  ${FEATHERS_URL}${serviceName}/"                                              ;

fi


sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.schema.js   <<END_OF_SCHEMA_SED        ;
s|additionalProperties: false|additionalProperties: true ${globalComment} |                                      ;
END_OF_SCHEMA_SED

exit 1;




        ####sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.schema.js   <<END_OF_SCHEMA_SED        ;
        ####s|additionalProperties: false|additionalProperties: true ${globalComment} |                                      ;
        ####END_OF_SCHEMA_SED
        ####s|^  { additionalProperties: false }|  { additionalProperties: true }  ${globalComment}                          |;



#
