#! /bin/bash

##   client-session   -- 2026-08-25

globalComment=${1}            ;
                                                               ##serviceName=${1}              ;          
serviceName=$(basename "${0%.*}")  ;


sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.schema.js   <<END_OF_SCHEMA_SED      ;

/    id: Type.Number(),/{N; s/    id: Type.Number(),\n    text: Type.String()/                 ${globalComment}  \\
     'layoutName'                  : Type.String({ minLength: 4, maxLength: 4 })               ${globalComment}  \\
  ,  'teacherEmail'                : Type.String({ format: 'email', maxLength: 255 })          ${globalComment}  \\
  ,  'clientMasterEmail'           : Type.String({ format: 'email', maxLength: 255 })          ${globalComment}  \\
  ,  'sessionName'                 : Type.String({ maxLength: 30 })                            ${globalComment}  \\
  ,  'clientSessionNotes'          : Type.Union([Type.String(), Type.Null()])                  ${globalComment}  \\
  ,  'createdAt'                   : Type.String({ format: 'date-time' })                      ${globalComment}  \\
  ,  'updatedAt'                   : Type.String({ format: 'date-time' })                      ${globalComment}  \\
  ,  'sessionNamesAutoIncr'        : Type.Integer({maximum: 255 })                             ${globalComment}  \\
  ,  'clientMasterAutoIncr'        : Type.Integer({maximum: 65535 })                           ${globalComment}  \\
  ,  'clientSessionAutoInc'r       : Type.Integer({ maximum: 65535 })                          ${globalComment}  \\
/}                                                                                                               ;
#
#
#
s/\['text']/                                          \\
  [  'layoutName'                   ${globalComment}  \\
  ,  'teacherEmail'                 ${globalComment}  \\
  ,  'clientMasterEmail'            ${globalComment}  \\
  ,  'sessionName'                  ${globalComment}  \\
  ,  'clientSessionNotes'           ${globalComment}  \\
  ,  'createdAt'                    ${globalComment}  \\
  ,  'updatedAt'                    ${globalComment}  \\
  ,  'sessionNamesAutoIncr'         ${globalComment}  \\
  ,  'clientMasterAutoIncr'         ${globalComment}  \\
  ,  'clientSessionAutoIncr'        ${globalComment}  \\
  ]                                                   \\
/                                                     ;
#
#
#
s/\['id', 'text']/                                    \\
  [  'clientSessionAutoIncr'        ${globalComment}  \\
  ,  'layoutName'                   ${globalComment}  \\
  ,  'teacherEmail'                 ${globalComment}  \\
  ,  'clientMasterEmail'            ${globalComment}  \\
  ,  'sessionName'                  ${globalComment}  \\
  ,  'clientSessionNotes'           ${globalComment}  \\
  ,  'createdAt'                    ${globalComment}  \\
  ,  'updatedAt'                    ${globalComment}  \\
  ,  'sessionNamesAutoIncr'         ${globalComment}  \\
  ,  'clientMasterAutoIncr'         ${globalComment}  \\
  ]                                                   \\
/                                                     ;
#

END_OF_SCHEMA_SED

exit;
