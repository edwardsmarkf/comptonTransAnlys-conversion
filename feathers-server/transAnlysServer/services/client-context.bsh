#! /bin/bash

##   client-context   -- 2026-08-25

##serviceName=${1}              ;          
serviceName=$(basename "${0%.*}")  ;
globalComment=${2}            ;


sed   --in-place   --file=-  ./src/services/${serviceName}/${serviceName}.schema.js   <<END_OF_SCHEMA_SED      ;

    id: Type.Number(),/{N; s/    id: Type.Number(),\n    text: Type.String()/                  \\
       layoutName                      : Type.String({ maxLength: 4 })                         \\
    ,  teacherEmail                    : Type.String({ maxLength: 255 })                       \\
    ,  clientMasterEmail               : Type.String({ maxLength: 255 })                       \\
    ,  sessionName                     : Type.String({ maxLength: 30 })                        \\
    ,  soundPhoneme                    : Type.String({ maxLength: 3 })                         \\
    ,  contextPosition                 : Type.String({ maxLength: 20 })                        \\
    ,  frequency                       : Type.String({ maxLength: 15 })                        \\
    ,  clientContextErrorSound         : Type.String({ maxLength: 4 })                         \\
    ,  clientContextErrorCount         : Type.Integer({ minimum: 0 })                          \\
    ,  clientContextErrorNotes         : Type.Optional(Type.String())                          \\
    ,  createdAt                       : Type.Optional(Type.String({ format: 'date-time' }))   \\
    ,  updatedAt                       : Type.Optional(Type.String({ format: 'date-time' }))   \\
    ,  frequencyListAutoIncr           : Type.Integer()                                        \\
    ,  contextAutoIncr                 : Type.Integer()                                        \\
    ,  clientSessionAutoIncr           : Type.Integer()                                        \\
    ,  clientContextAutoIncr           : Type.Optional(Type.Integer())                         \\
}                                                                                              ;
#
s/\['text']/                        \\
  [  'layoutName'                   \\
  ,  'teacherEmail'                 \\
  ,  'clientMasterEmail'            \\
  ,  'sessionName'                  \\
  ,  'soundPhoneme'                 \\
  ,  'contextPosition'              \\
  ,  'frequency'                    \\
  ,  'clientContextErrorSound'      \\
  ,  'clientContextErrorCount'      \\
  ,  'clientContextErrorNotes'      \\
  ,  'frequencyListAutoIncr'        \\
  ,  'contextAutoIncr'              \\
  ,  'clientSessionAutoIncr'        \\
  ],
                                    ;
#

END_OF_SCHEMA_SED

exit;
#

