#!  /bin/bash
#
#
#      client-stimword-before-get-patch.bsh    2026-07/25


##   create the feathers service using tcl/expect


export hookName='client-stimword-before-get-patch'                                                                                     ;

export serviceType='regular'                                                                                               ;

expect <(cat <<'END_OF_GENERATE_HOOK'
        #       generates a feathers service


                ## debugging:  exp_internal 1                   ;
        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

              #npx feathers generate hook   --name  shit --type regular
        spawn npx feathers generate hook   --name  $env(hookName)         --type $env(serviceType)                      ;


expect eof

END_OF_GENERATE_HOOK
)       ## end of feathers generate app



sed --in-place  --file=-  ./src/hooks/${hookName}.js   <<END_OF_SED ;
/console.log..Running hook .* on $.context\.path}\.\${context\.method}.*/a                                              \\
  return async context => {                                                                                             \\
        context.params.query = {                        // added by mark                                                \\
          ...context.params.query,                      // added by mark                                                \\
          $select: ['clientStimwordNotes']              // added by mark                                                \\
        }                                               // added by mark                                                \\
    return context;                                                                                                     \\


END_OF_SED


###   import { clientStimwordBeforeGetPatch}  from '../../hooks/client-stimword-before-get-patch.js'; /* added by mark   */


sed  --in-place  --file=-  ./src/services/client-stimword/client-stimword.js    <<END_OF_SED  ;

/^import {$/i
import { clientStimwordBeforeGetPatch}  from '../../hooks/$env(hookName).js'; /* added by mark   */



s/get: \[]/get: [clientStimwordBeforeGetPatch]     \/* added by mark  \//;
/patch: \[/a
     clientStimwordBeforeGetPatch,    /* added by mark */


END_OF_SED

exit  ;

