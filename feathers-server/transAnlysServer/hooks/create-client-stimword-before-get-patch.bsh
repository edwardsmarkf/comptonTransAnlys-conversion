#!  /bin/bash
#
#
#      client-stimword-before-get-patch.bsh    2026-07/25


##   create the feathers service using tcl/expect

export serviceName='client-stimword'                                                                                   ;
export hookName='-before-get-patch'                                                                                    ;
export serviceType='regular'                                                                                           ;
export hookVarName='clientStimwordBeforeGetPatch'                                                                      ;

expect <(cat <<'END_OF_GENERATE_HOOK'
        #       generates a feathers service


                ## debugging:  exp_internal 1                   ;
        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate hook --name $env(serviceName)$env(hookName)  --type $env(serviceType)               ;


expect eof

END_OF_GENERATE_HOOK
)       ## end of feathers generate app



sed --in-place  --file=-  ./src/hooks/${hookName}.js   <<END_OF_HOOK_SED ;
/console.log..Running hook .* on $.context\.path}\.\${context\.method}.*/a                                              \\
  return async context => {                                                                                             \\
        context.params.query = {                        // added by mark                                                \\
          ...context.params.query,                      // added by mark                                                \\
          \$select: ['clientStimwordNotes']              // added by mark                                                \\
        }                                               // added by mark                                                \\
    return context;                                     // added by mark                                                \\
  ?                                                     // added by mark                                                \\

/^import{$/i

import { $env(hookVarName) }  from '../../hooks/$env(hookName).js';

END_OF_HOOK_SED




sed  --in-place  --file=-  ./src/services/${serviceName}/${serviceName}.js    <<END_OF_SERVICE_SED  ;

/^import {$/i
import { $env(hookVarName)}  from '../../hooks/$env(serviceName)$env(hookName).js'; /* added by mark   */

s/get: \[]/get: [$env(hookVarName)]     \/* added by mark  \//;
/patch: \[/a
     $env(hookVarName),    /* added by mark */

END_OF_SERVICE_SED

exit  ;

#


