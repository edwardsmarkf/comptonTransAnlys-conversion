#!  /bin/bash  -w
#
#    template-create.bsh   2026-08-02

export serviceName=$1  ;
export hookSuffix=$2   ;
export hookType=$3     ;

export camelName=$(echo "${serviceName}-${hookSuffix}" | sed --regexp-extended 's/-([a-z])/\U\1/g' ;)                   ;

export hookName=${serviceName}${hookSuffix}                                                                             ;

expect <(cat <<'END_OF_GENERATE_HOOK'
        #       generates a feathers hook

        ##   debugging:   exp_internal 1

        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate hook   --name  $env(hookName)         --type $env(hookType)   ;

expect eof

END_OF_GENERATE_HOOK
)       ## end of feathers generate hook

exit;
#
