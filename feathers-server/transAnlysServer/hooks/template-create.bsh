#!  /bin/bash  -w
#
#    template-create.bsh   2026-08-02

export serviceName=$1  ;
export hookSuffix=$2   ;
export hookType=$3     ;


export hookName="${serviceName}-${hookSuffix}"                                                   ;

expect <(cat <<'END_OF_GENERATE_HOOK'
        #       generates a feathers hook

        ##   debugging:   exp_internal 1

        set timeout -1                                                                            ;

        set UPARROW     \x1B\[A                                                                   ;
        set DOWNARROW   \x1B\[B                                                                   ;
        set SPACE       \x20                                                                      ;
        set RETURN      \x0d                                                                      ;

        spawn npx feathers generate hook   --name  $env(hookName)         --type $env(hookType)   ;

expect eof

END_OF_GENERATE_HOOK
)       ## end of feathers generate hook


                                          ##bash -vx  ../services/${specialProcess}.bsh
scriptName="../hooks/${hookName}.bsh"  ;
export hookVarName=$(echo ${hookName} | sed --regexp-extended 's/-([a-z])/\U\1/g' ;)               ;

if [ -f "${scriptName}" ]; then
    echo "${scriptName} - File exists."                                    ;
    bash -vx  ${scriptName}  ${serviceName}  ${hookName}   ${hookVarName}  ;
    exit 1                                                                 ;
else
    echo "${scriptName} - File does NOT exist....!"                        ;
    exit 0                                                                 ;
fi

#
