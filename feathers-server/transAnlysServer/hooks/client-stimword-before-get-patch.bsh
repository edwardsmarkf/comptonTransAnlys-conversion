#!  /bin/bash
#
#
#      client-stimword-before-get-patch.bsh    2026-07/25


##   create the feathers service using tcl/expect

export serviceName=${1}                                        ; 
export hookName=${2}                                           ;
export hookVarName=${3}                                        ; 
export globalComment={4}                                       ;


sed --in-place  --file=-  ./src/hooks/${hookName}.js   <<END_OF_HOOK_SED ;
/console.log..Running hook .* on $.context\.path}\.\${context\.method}.*/a                                    \\
  return async context => {                                                                                   \\
        context.params.query = {                         ${globalComment}                                     \\
          ...context.params.query,                       ${globalComment}                                     \\
          \$select: ['clientStimwordNotes']              ${globalComment}                                     \\
        }                                                ${globalComment}                                     \\
        return context;                                  ${globalComment}                                     \\
  }                                                      ${globalComment}                                     \\


END_OF_HOOK_SED


sed  --in-place  --file=-  ./src/services/${serviceName}/${serviceName}.js    <<END_OF_SERVICE_SED  ;

/^import {$/i                                                                                               \\
                                                                                                            \\
    import { ${hookVarName} }  from '../../hooks/${hookName}.js';                                           \\

s/get: \[]/get: [${hookVarName}]        ${globalComment}/                                                   ;

/patch: \[/a                                                                                                \\
                                                                                                            \\
            ${hookVarName},             ${globalComment}                                                    \\

END_OF_SERVICE_SED


exit  ;

#








###   import { clientStimwordBeforeGetPatch}  from '../../hooks/client-stimword-before-get-patch.js'; /* added by mark   */


