#!  /bin/bash
#
#
#      create-session-names-before-find.js    2026-07-25


##   create the feathers service using tcl/expect


export serviceName='session-names'                                                                                     ;
export hookSuffix='-before-find'                                                                                        ;
export hookVarName='sessionNamesBeforeFind'                                                                            ;
export hookType='regular'                                                                                               ;



export hookName=${serviceName}${hookSuffix}                                                                             ;

expect <(cat <<'END_OF_GENERATE_HOOK'
        #       generates a feathers hook

        ##   debugging:   exp_internal 1

        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate hook   --name  $env(hookName)         --type $env(hookType)   ;

expect eof

END_OF_GENERATE_HOOK
)       ## end of feathers generate hook




sed --in-place  --file=-  ./src/hooks/${hookName}.js   <<END_OF_HOOK_SED ;
/console.log..Running hook .* on $.context\.path}\.\${context\.method}.*/a                                              \\
        context.params.query = {                // added by mark                                                        \\
          ...context.params.query,              // added by mark                                                        \\
          $select: ['sessionName', 'sessionReplicate', 'sessionNamesShow66Words', 'sessionNamesAutoIncr' ],             // added by mark    \\
          $sort: { 'sessionOrderNbr' : 1 }                      // added by mark                                        \\  
        }                                       // added by mark                                                        \\
        return context;                                                                                                 \\


END_OF_HOOK_SED

sed --in-place  --file=-   ./src/services/${serviceName}/${serviceName}.js          <<END_OF_SERVICE_SED           ;
s?find: \[]?find: [${hookVarName}]?;

/^import {$/i                                                                                                           \\
                                                                                                                        \\
   import { ${hookVarName} }  from '../../hooks/${hookName}.js';                                                        \\
                                                                                                                        \\

END_OF_SERVICE_SED

exit  ;

#
