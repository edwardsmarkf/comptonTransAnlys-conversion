#!  /bin/bash
#
#
#      create-client-session-before-find.js    2026-022


##   create the feathers service using tcl/expect


export serviceName='client-session'                                                                                     ;
export hookName='=before-find'                                                                                          ;
export hookVarName='clientSessionBeforeFind'                                                                            ;
export serviceType='regular'                                                                                             ;

expect <(cat <<'END_OF_GENERATE_HOOK'
        #       generates a feathers service


                ## debugging:  exp_internal 1                   ;
        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate hook --name  $env(serviceName)$env(hookName)  --type $env(serviceType)              ;


expect eof

END_OF_GENERATE_HOOK
)       ## end of feathers generate app



sed --in-place  --file=-  ./src/hooks/${serviceName}${hookName}.js   <<END_OF_HOOK_SED ;
/console.log..Running hook .* on $.context\.path}\.\${context\.method}.*/a                                              \\
        context.params.query = {                // added by mark                                                        \\
          ...context.params.query               // added by mark                                                        \\
        }                                       // added by mark                                                        \\
        return context;                                                                                                 \\


END_OF_HOOK_SED



sed --in-place  --file=-  ./src/services/${serviceName}.js   <<END_OF_SERVICE_SED ;

s/find: \[]/find: [${hookVarName}]/  ;

/^import {$/i                                                                                                             \\
                                                                                                                          \\
import { $hookVarName}  }  from '../../hooks/${serviceName}${hookName}.js';   \/*  added by mark  *\/                     \\

END_OF_SERVICE_SED

exit  ;

