#!  /bin/bash
#
#
#      create-language-norms-before-find.js    2026-07-25


##   create the feathers service using tcl/expect


export serviceName=${1}                                ;
export hookName=${2}                                   ;
export hookVarName=${3}                                ;
export globalComment={4}                                ;


sed --in-place  --file=-  ./src/hooks/${hookName}.js   <<END_OF_HOOK_SED ;
/console.log..Running hook .* on $.context\.path}\.\${context\.method}.*/a                                              \\
                                                                                                                        \\
        const knexClient =   context.app.get('mysqlClient') ;                                                           \\
                                                                                              ${globalComment}          \\
        const query = context.service.createQuery(context.params) ;                           ${globalComment}           \\
                                                                                              ${globalComment}          \\
        // https://knexjs.org/guide/query-builder.html#knex                                   ${globalComment}          \\
        query   .clear  ('select')  // remove ALL existing columns from queryBuilder          ${globalComment}          \\
                .select( 'languageNormsName')                                                 ${globalComment}          \\
                .distinct()                                                                   ${globalComment}          \\
                .orderBy('languageNormsName')                                                 ${globalComment}          \\
                ;                                                                             ${globalComment}          \\
                                                                                              ${globalComment}          \\
        context.params.knex = query ;                                                         ${globalComment}          \\
                                                                                              ${globalComment}          \\
        return context;                                                                       ${globalComment}          \\

END_OF_HOOK_SED

sed --in-place  --file=-   ./src/services/${serviceName}/${serviceName}.js          <<END_OF_SERVICE_SED           ;
s?find: \[]?find: [${hookVarName}]?;

/^import {$/i                                                                                                           \\
                                                                                                                        \\
   import { ${hookVarName} }  from '../../hooks/${hookName}.js'   ;                      ${globalComment}               \\
                                                                                                                        \\

END_OF_SERVICE_SED

exit  ;

#





export hookType='regular'                                                                                               ;

export hookName=${serviceName}${hookSuffix}                                                                             ;

expect <(cat <<'END_OF_GENERATE_HOOK'
        #       generates a feathers hook

        ##   debugging:   exp_internal 1

        set timeout -1                                                                                                  ;

        set UPARROW     \x1B\[A                                                                                         ;
        set DOWNARROW   \x1B\[B                                                                                         ;
        set SPACE       \x20                                                                                            ;
        set RETURN      \x0d                                                                                            ;

        spawn npx feathers generate hook   --name  $env(hookName)         --type $env(hookType)   ;

expect eof

END_OF_GENERATE_HOOK
)       ## end of feathers generate hook


