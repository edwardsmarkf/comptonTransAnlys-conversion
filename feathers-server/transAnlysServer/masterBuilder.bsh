#!  /bin/bash
#
#       master-build.bsh        2027-07-26
#
#       (re)construct the phonetic analysis server
#
#
export FEATHERS_SERVER_NAME=$1                                            ;
#
#
#
#
bash -vx        ./createApp.bsh         ${FEATHERS_SERVER_NAME}           ;
#
#
mv     --verbose  ./custom/  ./sql/  ./${FEATHERS_SERVER_NAME}/src/   ;
#
#
cd ${FEATHERS_SERVER_NAME}                                                ;

# services:

for service-name in   client-context        \
                      client-master         \
                      client-session        \
                      client-stimword       \
                      error-sounds-tooltip  \
                      frequency-linst       \
                      language-norms        \
                      session-names         \
                      stimword              \
                      teacher               \
; do
    echo "Service name:                         ${service-name}"   ;
    bash -vx  ../services/template-create.bsh   ${service-name}    ;
done
#
bash -vx  ../services/create-client-context-stimword.bsh          ;
bash -vx  ../services/create-get-clients-emails.bsh               ;
bash -vx  ../services/create-knex-generic-raw.bsh                 ;

#  hooks:

bash -vx   ../hooks/create-client-context-before-find.bsh         ;
bash -vx   ../hooks/create-client-session-before-find.bsh         ;
bash -vx   ../hooks/create-client-stimword-before-get-patch.bsh   ;
bash -vx   ../hooks/create-language-norms-before-find.bsh         ;
bash -vx   ../hooks/create-session-names-before-find.bsh          ;
bash -vx   ../hooks/create-stimword-before-find.bsh               ;
#
#
find  .  -type f  -name  '*.bsh' -exec grep  'export serviceName='  {}  \;    | sed --expression="s/export serviceName='//;s/'.*$//;"  ;
#
exit                                                                      ;
#





bash -vx  ../services/template-create.bsh                   client-context          ;
bash -vx  ../services/template-create.bsh                   client-context          ;
bash -vx  ../services/template-create.bsh                   client-context          ;
bash -vx  ../services/template-create.bsh                   client-session          ;       
bash -vx  ../services/template-create.bsh                   client-stimword         ;        
bash -vx  ../services/template-create.bsh                   error-sounds-tooltip    ;        
bash -vx  ../services/template-create.bsh                   frequency-list          ;     
bash -vx  ../services/template-create.bsh                   language-norms          ;        
bash -vx  ../services/template-create.bsh                   session-names           ;       
bash -vx  ../services/template-create.bsh                   stimword                ;        
bash -vx  ../services/template-create.bsh                   teacher                 ;        
