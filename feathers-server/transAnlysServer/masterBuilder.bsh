#!  /bin/bash
#
#       master-build.bsh        2027-07-26
#
#       (re)construct the phonetic analysis server
#
#
export FEATHERS_SERVER_NAME=${1}                             ;
#
#
port=3030                ;
export FEATHERS_URL="http://$(hostname  --all-ip-address | sed --expression='s/ //;' ;):${port}/"  ;

echo  $FEATHERS_URL
echo  $FEATHERS_URL


echo  $FEATHERS_URL

echo  $FEATHERS_URL

export globalComment='GLOBAL_COMMENT_TO_BE_REPLACED_AT_END'          ;
ScriptName="${BASH_SOURCE[0]##*/}"                                   ;
TimeStamp=$(date +'%Y-%m-%d_%H-%M-%S';)                              ;
export Final_Comment="/* Added by ${ScriptName} -- ${TimeStamp} */"  ;

#
#
#
#
bash -vx        ./createApp.bsh         ${FEATHERS_SERVER_NAME}          ;
#
#
mv     --verbose  ./custom/  ./sql/  ./${FEATHERS_SERVER_NAME}/src/   ;
#
#
#
sed --in-place  --file=-    ./config/default.json    <<END_OF_CONFIG_DEFAULT_JSON ;
/^{$/a                                                       \\
    'voiceFileDirectory'   : '/home/mark/voicefiles/'  ,     \\

END_OF_CONFIG_DEFAULT_JSON

#
cd ${FEATHERS_SERVER_NAME}                                                ;

# services:

while read -r serviceName serviceType specialProcess; do
    echo  "Service name:  ${serviceName}"                                                                               ;
    bash -vx  ../services/template-create.bsh   ${serviceName}   ${serviceType}  ${globalComment}  ${specialProcess}    ;
done <<END_OF_SERVICE_FILE ;
  client-context                knex
  client-context-stimword       custom      client-context-stimword
  client-master                 knex
  client-session                knex
  client-stimword               knex
  error-sounds-tooltip          knex
  frequency-list                knex
  get-clients-emails            custom      get-clients-emails  
  knex-generic-raw              custom      knex-generic-raw
  language-norms                knex
  session-names                 knex
  stimword                      knex
  teacher                       knex
END_OF_SERVICE_FILE

#

#  hooks:

while read -r serviceName hookNameSuffix hookType; do
    echo "Hook name:   ${serviceName}-${hookNameSuffix}"                                                     ;
    bash -vx  ../hooks/template-create.bsh   ${serviceName}  ${hookNameSuffix} ${hookType}  ${globalComment} ;
done <<END_OF_HOOKS_FILE ;
         client-context   before-find        regular
         client-session   before-find        regular
         client-stimword  before-get-patch   regular
         language-norms   before-find        regular
         session-names    before-find        regular
         stimword         before-find        regular
END_OF_HOOKS_FILE


#
#

find  ./src/   -type f -name  '*.js'  -exec grep ${globalComment} {}  \;     | wc --lines    ;

find  ./src/   -type f -name  '*.js'  -print                                                 \
      -exec sed --in-place --expression="s|${globalComment}|${Final_Comment}|  ;"  {}  \;    ;

find  ./src/   -type f -name  '*.js'  -exec grep ${TimeStamp} {}  \;     | wc --lines        ;


#
exit                                                                      ;
#








