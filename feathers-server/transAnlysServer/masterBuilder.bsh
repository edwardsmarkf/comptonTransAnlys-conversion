#!  /bin/bash
#
#       master-build.bsh        2027-07-26
#
#       (re)construct the phonetic analysis server
#
#
export FEATHERS_SERVER_NAME=$1                                            ;
#
#
#
#
bash -vx        ./createApp.bsh         ${FEATHERS_SERVER_NAME}           ;
#
#
mv     --verbose  ./custom/  ./sql/  ./${FEATHERS_SERVER_NAME}/src/   ;
#
#
cd ${FEATHERS_SERVER_NAME}                                                ;

# services:

while read -r serviceName serviceType specialProcess; do
    bash -vx  ../services/template-create.bsh   ${serviceName}   ${serviceType}  ${specialProcess}    ;
done <<END_OF_SERVICE_FILE ;
  client-context                knex
  client-context-stimword       custom      client-context-stimword
  client-master                 knex
  client-session                knex
  client-stimword               knex
  error-sounds-tooltip          knex
  frequency-list                knex
  get-clients-emails            custom      get-clients-emails  
  knex-generic-raw              custom      knex-generic-raw
  language-norms                knex
  session-names                 knex
  stimword                      knex
  teacher                       knex
END_OF_SERVICE_FILE

#

#  hooks:

while read -r serviceName hookNameSuffix hookType; do
    echo "Hook name:   ${serviceName}-${hookNameSuffix}"                                        ;
    bash -vx  ../hooks/template-create.bsh   ${serviceName}  ${hookNameSuffix} ${hookType}   ;
done <<END_OF_HOOKS_FILE ;
         client-context   before-find        regular
         client-session   before-find        regular
         client-stimword  before-get-patch   regular
         language-norms   before-find        regular
         session-names    before-find        regular
         stimword         before-find        regular
END_OF_HOOKS_FILE


#
#

#for serviceName in $(ls   ./src/services |  grep -v  index.js ; ) ;   do
#    echo  "http://$(hostname  --all-ip-address | sed --expression='s/ //;' ;):3030/${serviceName}"/  ; 
#done

#
exit                                                                      ;
