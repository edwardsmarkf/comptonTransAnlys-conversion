#!  /bin/bash  -w

#   install-npm-and-feathers.bsh    -- 2026-07-13

##  script to install npm and feathers 
##  in case npm/feathers is NOT installed yet:


sudo  curl --fail --silent --show-error  --location https://rpm.nodesource.com/setup_26.x | sudo bash -    ;
sudo  dnf    --assumeyes  install    expect   nodejs                    ;
sudo  npm install --global  npm@12.0.1                                  ;


node  --version                                                   ;
npm   --version                                                   ;

npm install @feathersjs/feathers --save                           ;

npm   view   @feathersjs/feathers  version                        ;


exit ;


